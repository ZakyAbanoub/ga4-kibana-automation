# Copy to .env for local runs. On Vercel, set these as project env vars.
GA4_PROPERTY_ID=482794016
# Internal spreadsheet — receives raw_* tabs (audit) + presentation tabs.
SPREADSHEET_ID=1GM3EAQgtGH93YQggku98C6SO9C_JFVaiqvyE_pAPwVA
# Optional client spreadsheet — when set, the refresh also writes here with
# raw tabs forced off (presentation only). Leave blank to write only the internal copy.
CLIENT_SPREADSHEET_ID=
# Raw tab visibility on the internal spreadsheet: hidden (default) | visible | off
RAW_TABS=hidden

# Google service account (GA4 + Sheets).
# Local: path to the JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=secrets/ga4-service-account.json
# Vercel: paste the JSON key contents into a single env var instead.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Kibana / OpenSearch.
KIBANA_BASE_URL=https://stats.loquis.com
KIBANA_INDEX=plays
KIBANA_USER=
# Password base64-encoded (contains '"# chars). KIBANA_PASS (plain) also works.
KIBANA_PASS_B64=

# WordPress source for /api/pages.
WP_BASE_URL=https://lastminute.loquis.com
# Optional bearer token gating /api/pages (leave blank for a public endpoint).
PAGES_API_TOKEN=

# Personal Vercel token for ./bin/vercel — pin this directory to your
# personal account regardless of which team `vercel login` last switched to.
# Create at https://vercel.com/account/tokens (full-access or project-scoped).
VERCEL_TOKEN=
